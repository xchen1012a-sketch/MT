# 复制为 .env 后填写真实值；.env 不入库
PROJECT_NAME="MT5 中控台"
# openssl rand -hex 32
SECRET_KEY=replace-me
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=replace-me
